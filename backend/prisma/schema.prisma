generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum RecordStatus {
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum ReminderStatus {
  PREPARED
  SENT
  DELIVERED
  FAILED
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  customers        Customer[]
  creditEntries    CreditEntry[]
  payments         Payment[]
  messageTemplates MessageTemplate[]
  reminderLogs     ReminderLog[]
  auditLogs        AuditLog[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  creditsCreated  CreditEntry[]    @relation("CreditCreatedBy")
  creditsReversed CreditEntry[]    @relation("CreditReversedBy")
  paymentsCreated Payment[]        @relation("PaymentCreatedBy")
  paymentsReversed Payment[]       @relation("PaymentReversedBy")
  templatesCreated MessageTemplate[]
  remindersSent   ReminderLog[]
  auditLogs       AuditLog[]

  @@index([businessId])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  phone      String
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id])
  creditEntries CreditEntry[]
  payments      Payment[]
  reminderLogs  ReminderLog[]

  @@unique([businessId, phone])
  @@index([businessId, name])
}

model CreditEntry {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @db.Uuid
  customerId     String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  description    String?
  entryDate      DateTime     @default(now())
  status         RecordStatus @default(POSTED)
  idempotencyKey String       @db.Uuid
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  reversedAt     DateTime?
  reversedById   String?      @db.Uuid
  reversalReason String?

  business   Business @relation(fields: [businessId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("CreditCreatedBy", fields: [createdById], references: [id])
  reversedBy User?    @relation("CreditReversedBy", fields: [reversedById], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([customerId, status])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @db.Uuid
  customerId     String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  paymentDate    DateTime      @default(now())
  status         RecordStatus  @default(POSTED)
  idempotencyKey String        @db.Uuid
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  reversedAt     DateTime?
  reversedById   String?       @db.Uuid
  reversalReason String?

  business   Business @relation(fields: [businessId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  reversedBy User?    @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([customerId, status])
}

model MessageTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  body        String
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  reminderLogs ReminderLog[]

  @@index([businessId])
}

model ReminderLog {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  customerId      String         @db.Uuid
  templateId      String?        @db.Uuid
  sentById        String         @db.Uuid
  message         String
  balanceSnapshot Decimal        @db.Decimal(12, 2)
  status          ReminderStatus @default(PREPARED)
  failureReason   String?
  createdAt       DateTime       @default(now())
  sentAt          DateTime?

  business Business         @relation(fields: [businessId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  template MessageTemplate? @relation(fields: [templateId], references: [id])
  sentBy   User             @relation(fields: [sentById], references: [id])

  @@index([businessId, customerId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}